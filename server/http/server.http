@baseUrl=http://localhost:3000

### POST: Crea una nueva encuesta
# @name crearEncuesta
POST {{baseUrl}}/survey
Content-Type: application/json

{
  "question": "¿Cuál es tu framework favorito?",
  "options": [
    { "text": "Express" },
    { "text": "Fastify" }
  ]
}
###
# Capturamos el ID de la respuesta anterior usando .response.body.*
@idEncuesta = {{crearEncuesta.response.body.id}}


### POST: Crea una nueva encuesta INVÁLIDA
POST {{baseUrl}}/survey
Content-Type: application/json

{
  "question": "¿Cuál es tu framework favorito?",
  "options": [
    { "text": "Fastify" }
  ]
}

### GET: Obtenemos la encuesta recien creada
GET {{baseUrl}}/survey/{{idEncuesta}}


### GET: Obtenemos la encuesta INVÁLIDA
GET {{baseUrl}}/survey/1000


### POST: Votamos
POST {{baseUrl}}/survey/{{idEncuesta}}/vote
Content-Type: application/json

{
  "optionIndex": 1
}

### POST: Votamos INVÁLIDA
POST {{baseUrl}}/survey/1/vote
Content-Type: application/json

{
  "optionIndex": 1
}



### POST: Votamos INVÁLIDA
POST {{baseUrl}}/survey/{{idEncuesta}}/vote
Content-Type: application/json

{
  "optionIndex": 4
}