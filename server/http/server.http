@baseUrl=http://localhost:3000

### POST: Crea una nueva encuesta
POST {{baseUrl}}/survey
Content-Type: application/json

{
  "question": "¿Cuál es tu framework favorito?",
  "options": [
    { "text": "Express" },
    { "text": "Fastify" }
  ]
}


### POST: Crea una nueva encuesta INCORRECTO
POST {{baseUrl}}/survey
Content-Type: application/json

{
  "question": "¿Cuál es tu framework favorito?",
  "options": [
    { "text": "Fastify" }
  ]
}

### GET: Obtenemos la encuesta recien creada
GET {{baseUrl}}/survey/1


### GET: Obtenemos la encuesta inválido
GET {{baseUrl}}/survey/1000


### POST: Votamos
POST {{baseUrl}}/survey/1/vote
Content-Type: application/json

{
  "optionIndex": 1
}