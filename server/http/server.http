@baseUrl=http://localhost:3000

### POST: Crea una nueva encuesta
POST {{baseUrl}}/suvery
Content-Type: application/json

{
  "question": "¿Cuál es tu framework favorito?",
  "options": [
    { "text": "Express" },
    { "text": "Fastify" }
  ]
}


